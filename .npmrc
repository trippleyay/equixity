# npm strict peer resolver cannot satisfy this tree: @privy-io/node wants
# @solana/kit ^5.1.0 while the root and @solana-program/* use ^8. Both Privy
# kit peers are optional and the two majors coexist (verified locally: 8.3.0
# at root, 5.5.1 nested under @coinbase/cdp-sdk), but fresh CI npm (Vercel)
# rejects the resolution with ERESOLVE. legacy-peer-deps makes npm honor the
# existing lockfile tree everywhere, deterministically.
legacy-peer-deps=true
