# ============================================================
# Equixity — Merchant MVP. Committed template.
# Copy to .env.local and fill in. Never commit .env.local.
# ============================================================

# --- App runtime vars (spec section 3 names) ---

# Public: safe to ship to the browser. Project URL + publishable/anon key.
# (Supabase's current dashboard still also calls the publishable key the
# "anon key"; either value works the same way.)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Server-only. Must never appear under a NEXT_PUBLIC_ prefix.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Server-only. Alchemy Solana RPC (mainnet-beta).
ALCHEMY_SOLANA_RPC_URL=""

# Server-only. AES-256-GCM key for encrypting per-merchant deposit private
# keys at rest. Hex-encoded 32 bytes (64 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEPOSIT_KEY_ENCRYPTION_SECRET=""

# Server-only. Base58-encoded 64-byte Ed25519 secret key for the Equixity
# fee-payer wallet. Covers the SOL network fee (and, when a withdrawal
# destination has never held USDC, the one-time ATA rent) on every withdrawal.
# It must never hold transfer authority over any merchant's USDC; keep a small
# SOL balance on it. Generate a keypair and encode its secretKey as base58.
FEE_PAYER_SECRET_KEY=""

# Public: app origin used to build the SDK snippet
NEXT_PUBLIC_APP_URL=""
